# Telegram Bot Token
BOT_TOKEN=your_telegram_bot_token_here

# Supabase (bepul Postgres bazasi)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# English Practice AI Modeli (Google Gemini Flash & Fallbacks)
ENGLISH_AI_PRIMARY=gemini
ENGLISH_GEMINI_API_KEY=your-gemini-api-key
ENGLISH_GEMINI_MODEL=gemini-2.5-flash

# Fallback AI (Groq yoki Cerebras)
ENGLISH_GROQ_API_KEY=your-groq-api-key
ENGLISH_GROQ_WHISPER_MODEL=whisper-large-v3

# Development rejimida auth bypass
ENGLISH_DEV_BYPASS_AUTH=true
NODE_ENV=development
